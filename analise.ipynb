import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv("vendas.csv", encoding="latin-1")

print("Primeiras linhas do conjunto de dados:")
display(df.head())

print("\nDimensões do conjunto de dados:")
print(f"{df.shape[0]} linhas e {df.shape[1]} colunas")

print("\nColunas disponíveis:")
print(df.columns.tolist())

print("\nInformações do conjunto de dados:")
df.info()

print("\nValores ausentes por coluna:")
print(df.isnull().sum())

vendas_categoria = (
    df.groupby("Category")["Sales"]
    .sum()
    .sort_values(ascending=False)
)

print("\nVendas por categoria:")
print(vendas_categoria)

vendas_categoria.sort_values().plot(
    kind="barh",
    title="Vendas por Categoria"
)

plt.xlabel("Total de Vendas")
plt.ylabel("Categoria")
plt.tight_layout()
plt.show()

vendas_regiao = (
    df.groupby("Region")["Sales"]
    .sum()
    .sort_values(ascending=False)
)

print("\nVendas por região:")
print(vendas_regiao)

vendas_regiao.sort_values().plot(
    kind="barh",
    title="Vendas por Região"
)

plt.xlabel("Total de Vendas")
plt.ylabel("Região")
plt.tight_layout()
plt.show()

df["Order Date"] = pd.to_datetime(df["Order Date"])

vendas_mes = (
    df.groupby(df["Order Date"].dt.month)["Sales"]
    .sum()
)

print("\nVendas por mês:")
print(vendas_mes)

vendas_mes.plot(
    kind="line",
    marker="o",
    title="Vendas por Mês"
)

plt.xlabel("Mês")
plt.ylabel("Total de Vendas")
plt.xticks(range(1, 13))
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

print("\nResumo da análise:")
print(f"Categoria com maior volume de vendas: {vendas_categoria.idxmax()}")
print(f"Região com maior volume de vendas: {vendas_regiao.idxmax()}")
print(f"Mês com maior volume de vendas: {vendas_mes.idxmax()}")
